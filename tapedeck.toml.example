# Tapedeck — infrastructure settings only.
#
# Everything user-facing lives in the web UI and the database: scrobble
# connections (ListenBrainz / Last.fm / Libre.fm) are per-user under
# Settings → Scrobble Connections, and Plex is under Settings → Plex (admin).
# Nothing in this file can move there — it's needed before the UI can be served.
#
# Precedence: environment > .env > this file > built-in default.
# Every key has a matching env var, e.g. [server] port -> PORT.

[server]
port = 8080
# Credential-encryption key. Generated on first run; keep it out of database
# backups, since a backup plus this key is the same as no encryption at all.
secret_key_path = "./tapedeck.key"
host = "0.0.0.0"
# Only enable behind a reverse proxy you control — it makes X-Forwarded-For
# trusted for client IPs, which the login rate limiter keys on.
trust_proxy = false

# What this instance is reached at from outside, if that differs from what the
# server itself can see — behind Cloudflare Tunnel, nginx or any reverse proxy.
#
# Worth setting if you use the MCP surface. It is published as the OAuth issuer
# and as every endpoint URL, and an authorization server advertising http://
# is one a hosted assistant will refuse — which shows up as a connector that
# signs in and then has no tools. Left empty, the server infers it: forwarded
# headers when trust_proxy is on, otherwise the Host header with https assumed
# for a public hostname and http for a LAN one.
# public_url = "https://tapedeck.example.com" 

[database]
# Listens and all app state.
scrobble_db_url = "sqlite:scrobbles.db"
# Separate SQLite file for the MusicBrainz metadata cache.
sqlite_path = "./tapedeck.db"
# Uploaded sleeve and booklet scans. Files beside the database rather than blobs
# inside it, so `GET /api/v1/backup` does not carry them — back this directory up
# too, or use `GET /api/v1/physical/export`.
uploads_dir = "./uploads"

[logging]
level = "info"
dir = "./logs"
file_enabled = true
console_enabled = true

[musicbrainz]
# Their API requires a contact address in the User-Agent.
user_agent = "Tapedeck/0.10.0 ( your-email@example.com )"
rate_limit_per_second = 1
# Optional: a local MusicBrainz Postgres mirror, queried before the API.
enable_postgres = false
postgres_url = ""
