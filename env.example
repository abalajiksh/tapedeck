# ══════════════════════════════════════════════════════════
#  Tapedeck — Environment Variable Overrides
# ══════════════════════════════════════════════════════════
#
#  Tapedeck loads configuration from tapedeck.toml first,
#  then applies environment variables as overrides.
#
#  This file is ideal for secrets (tokens, API keys) that
#  you don't want in version control. For everything else,
#  use tapedeck.toml.
#
#  If no tapedeck.toml exists, env vars work standalone
#  (backward compatible with pre-0.5 setups).
# ══════════════════════════════════════════════════════════

# Logging (overrides [logging] in tapedeck.toml)
# RUST_LOG=info

# Plex (overrides [sources.plex] in tapedeck.toml)
# PLEX_ENABLED=true
# PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=your_plex_token_here

# Last.fm (overrides [sinks.lastfm] in tapedeck.toml)
# LASTFM_ENABLED=true
LASTFM_API_KEY=your_api_key
LASTFM_SECRET=your_secret
LASTFM_SESSION_KEY=your_session_key

# ListenBrainz (overrides [sinks.listenbrainz] in tapedeck.toml)
# LISTENBRAINZ_ENABLED=true
LISTENBRAINZ_TOKEN=your_listenbrainz_token

# MusicBrainz PostgreSQL (optional)
# MUSICBRAINZ_POSTGRES_URL=postgresql://localhost/musicbrainz_db
# MUSICBRAINZ_POSTGRES_ENABLED=false
