# --- SOURCES ---
# Plex
PLEX_ENABLED=true
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=your-plex-token

# Jellyfin (Use API Token)
JELLYFIN_ENABLED=false
JELLYFIN_URL=http://192.168.1.11:8096
JELLYFIN_USER_ID=your-user-guid
JELLYFIN_TOKEN=your-api-key

# Navidrome (Best via Direct DB for history)
NAVIDROME_ENABLED=false
NAVIDROME_DB_PATH=/var/lib/navidrome/navidrome.db

# --- SINKS ---
# Last.fm
LASTFM_ENABLED=true
LASTFM_API_KEY=your-api-key
LASTFM_SECRET=your-secret
LASTFM_USER=your-username
LASTFM_PASS=your-password

# ListenBrainz
LISTENBRAINZ_ENABLED=true
LISTENBRAINZ_TOKEN=your-user-token
