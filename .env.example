# General
RUST_LOG=info
IS_PRODUCTION=false

# Plex Configuration
PLEX_ENABLED=true
PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=your_plex_token_here

# Plex Filters (comma-separated, case-insensitive)
PLEX_USERS_ALLOW=myusername,spouse
PLEX_USERS_BLOCK=guest
PLEX_DEVICES_ALLOW=
PLEX_DEVICES_BLOCK=chromecast,smart tv
PLEX_LIBRARIES_ALLOW=music,high-res audio
PLEX_LIBRARIES_BLOCK=audiobooks,podcasts

# Last.fm Configuration
LASTFM_ENABLED=true
LASTFM_API_KEY=your_api_key
LASTFM_SECRET=your_secret
LASTFM_SESSION_KEY=your_session_key

# ListenBrainz Configuration
LISTENBRAINZ_ENABLED=true
LISTENBRAINZ_TOKEN=your_listenbrainz_token
LISTENBRAINZ_URL=https://lb.maeve-nightshade.app

# Navidrome (not implemented yet)
NAVIDROME_ENABLED=false
NAVIDROME_DB_PATH=./navidrome.db

# Jellyfin (not implemented yet)
JELLYFIN_ENABLED=false
JELLYFIN_URL=http://localhost:8096
JELLYFIN_USER_ID=
JELLYFIN_TOKEN=
