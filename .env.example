# Tapedeck — infrastructure settings only.
#
# Everything user-facing lives in the web UI and the database: scrobble
# connections (ListenBrainz / Last.fm / Libre.fm) are per-user under
# Settings → Scrobble Connections, and Plex is under Settings → Plex (admin).
# Nothing below can move there — it's needed before the UI can be served.
#
# Precedence: environment > .env > tapedeck.toml > built-in default.

# ── Server ──
PORT=8080
HOST=0.0.0.0
# Only enable behind a reverse proxy you control — it makes X-Forwarded-For
# trusted for client IPs, which the login rate limiter keys on.
TRUST_PROXY=false

# What this instance is reached at from outside, if that differs from what the
# server can see. Published as the OAuth issuer for the MCP surface, so a wrong
# scheme here breaks connecting an AI assistant. Empty = infer it.
# PUBLIC_URL=https://tapedeck.example.com

# ── Credential encryption ──
# Credentials Tapedeck must replay (Plex tokens, Last.fm session keys, …) are
# encrypted at rest. The key is generated here on first run. Keep it OUT of your
# database backups — a backup plus this key is the same as no encryption. Losing
# it means every user reconnects their services.
TAPEDECK_SECRET_KEY_PATH=./tapedeck.key
# Or supply the key directly (base64, 32 bytes); takes precedence over the file.
# TAPEDECK_SECRET_KEY=

# ── Database ──
# Listens and all app state.
DATABASE_URL=sqlite:scrobbles.db
# Separate SQLite file for the MusicBrainz metadata cache.
SQLITE_DB_PATH=./tapedeck.db
# And another for the Every Noise genre map — bulk reference data scraped from
# a public site, kept out of the scrobble database so `VACUUM INTO` backups
# hold your listening rather than 6,300 rows of someone else's reference data.
EVERYNOISE_DB_PATH=sqlite:everynoise.db?mode=rwc
# Where uploaded sleeve and booklet scans are written. Files rather than blobs,
# because a booklet is twenty pages and a shelf of a hundred records would put
# gigabytes through every backup. The consequence: `GET /api/v1/backup` does NOT
# carry these — back this directory up alongside the database, or use
# `GET /api/v1/physical/export`, which does include them.
TAPEDECK_UPLOADS_DIR=./uploads

# ── Logging ──
RUST_LOG=info
LOG_DIR=./logs
ENABLE_FILE_LOGGING=true
ENABLE_CONSOLE_LOGGING=true

# ── MusicBrainz ──
# Their API requires a contact address in the User-Agent.
MUSICBRAINZ_USER_AGENT=Tapedeck/0.96.0 ( your-email@example.com )
MUSICBRAINZ_RATE_LIMIT=1
# Optional: a local MusicBrainz Postgres mirror, queried before the API.
# MUSICBRAINZ_POSTGRES_ENABLED=false
# MUSICBRAINZ_POSTGRES_URL=postgresql://musicbrainz:password@localhost:5432/musicbrainz_db

# ── Optional third-party metadata ──
# All of these are optional. Unconfigured is a normal state: the provider steps
# aside rather than erroring, and everything still works through MusicBrainz.

# Discogs — barcode to *pressing* for Vinyl & Tape, where MusicBrainz often only
# has "the album". Two credential shapes work and you need only one; the OAuth
# flow is not required, since Tapedeck only reads the public database.
# A personal access token (discogs.com/settings/developers → "Generate token"):
# TAPEDECK_DISCOGS_TOKEN=
# ...or an application's consumer key and secret from the same page:
# TAPEDECK_DISCOGS_KEY=
# TAPEDECK_DISCOGS_SECRET=
# Note Discogs does NOT reject a bad credential — it silently answers as if
# anonymous — so use the Test button in Settings → Connections to confirm it.

# Every Noise at Once — an address sent in the scraper's User-Agent so the
# site's owner can see who is asking. The scrape refuses to start without one.
# Can also be set in Settings → Genre Map.
# TAPEDECK_EVERYNOISE_CONTACT=you@example.com

# Artist and album descriptions, in preference order after Last.fm.
# TAPEDECK_AUDIODB_KEY=
# TAPEDECK_APPLE_MUSIC_TOKEN=
# TAPEDECK_APPLE_MUSIC_STOREFRONT=

# ── Metrics ──
# /metrics accepts a session cookie or this as a bearer token. Admin only.
# TAPEDECK_METRICS_TOKEN=
