# /etc/tapedeck/tapedeck.env — read by tapedeck.service.
#
# Infrastructure only; everything else is configured in the web UI. The full
# list of settings, with what each one is for, is in
# /usr/share/doc/tapedeck/env.example. Anything set here overrides it.
#
# Databases, the credential key and uploads default to /var/lib/tapedeck and
# logs to /var/log/tapedeck; there is no need to set those paths.

# REQUIRED for MusicBrainz and Cover Art Archive lookups. They block clients
# that do not identify themselves; unset, those lookups are disabled and the
# log says so at startup. An email address or a URL you can be reached at.
MUSICBRAINZ_CONTACT=

# PORT=8080
# HOST=0.0.0.0

# Behind a reverse proxy you control (nginx, Caddy, Cloudflare Tunnel):
# TRUST_PROXY=true
# PUBLIC_URL=https://tapedeck.example.com
