# Tapedeck Environment Configuration
# Copy this file to /etc/tapedeck/tapedeck.env and customize

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: trace, debug, info, warn, error (default: info)
RUST_LOG=info

# Enable file-based logging (default: true)
ENABLE_FILE_LOGGING=true

# Enable console logging (default: true)
ENABLE_CONSOLE_LOGGING=true

# Log directory path (default: /var/log/tapedeck)
LOG_DIR=/var/log/tapedeck

# Admin API port for runtime log level control (default: 8080)
ADMIN_PORT=8080

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Scrobble database URL
DATABASE_URL=sqlite:/var/tapedeck/data/scrobbles.db?mode=rwc

# MusicBrainz cache database
MUSICBRAINZ_SQLITE_PATH=/var/tapedeck/data/musicbrainz_cache.db

# ============================================================================
# PLEX CONFIGURATION
# ============================================================================

# Enable Plex source
PLEX_ENABLED=true

# Plex server URL (e.g., http://localhost:32400 or http://192.168.1.100:32400)
PLEX_URL=http://localhost:32400

# Plex authentication token
# Get it from: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=your-plex-token-here

# Optional: Filter by users (comma-separated)
# PLEX_USERS_ALLOW=john,jane
# PLEX_USERS_BLOCK=guest

# Optional: Filter by devices (comma-separated)
# PLEX_DEVICES_ALLOW=iPhone,Android
# PLEX_DEVICES_BLOCK=

# Optional: Filter by library names (comma-separated)
# PLEX_LIBRARIES_ALLOW=Music,Audio
# PLEX_LIBRARIES_BLOCK=

# ============================================================================
# LISTENBRAINZ CONFIGURATION
# ============================================================================

# Enable ListenBrainz scrobbling
LISTENBRAINZ_ENABLED=true

# ListenBrainz API base URL
# Official: https://api.listenbrainz.org
# Self-hosted: https://your-listenbrainz-instance.com
LISTENBRAINZ_BASE_URL=https://api.listenbrainz.org

# ListenBrainz user token
# Get it from: https://listenbrainz.org/profile/ (Your Tokens section)
LISTENBRAINZ_TOKEN=your-listenbrainz-token-here

# ============================================================================
# LAST.FM CONFIGURATION (Optional)
# ============================================================================

# Enable Last.fm scrobbling
LASTFM_ENABLED=false

# Last.fm API credentials
# Get from: https://www.last.fm/api/account/create
# LASTFM_API_KEY=your-lastfm-api-key
# LASTFM_SECRET=your-lastfm-secret
# LASTFM_SESSION_KEY=your-lastfm-session-key

# ============================================================================
# MUSICBRAINZ CONFIGURATION
# ============================================================================

# User agent for MusicBrainz API requests (required)
# Format: AppName/Version (Contact URL or Email)
MUSICBRAINZ_USER_AGENT=Tapedeck/0.3.13 (https://github.com/abalajiksh/tapedeck)

# Rate limit for MusicBrainz API (requests per second, default: 1)
# Increase only if you have permission or are using self-hosted instance
MUSICBRAINZ_RATE_LIMIT=1

# Enable PostgreSQL MusicBrainz database (optional, for faster lookups)
MUSICBRAINZ_ENABLE_POSTGRES=false

# PostgreSQL connection URL (only if MUSICBRAINZ_ENABLE_POSTGRES=true)
# MUSICBRAINZ_POSTGRES_URL=postgresql://musicbrainz:password@localhost:5432/musicbrainz_db
